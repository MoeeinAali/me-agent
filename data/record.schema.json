          "type": "string",
          "x-visibility": "public"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year",
          "x-visibility": "public"
        },
        "finished": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished",
          "x-visibility": "public"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note",
          "x-visibility": "public"
        },
        "link": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link",
          "x-visibility": "public"
        }
      },
      "required": [
        "id",
        "title",
        "author",
        "status"
      ],
      "title": "Book",
      "type": "object"
    },
