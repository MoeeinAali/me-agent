# Copy to .env and fill in LLM_API_KEY. Never commit .env.

# Backend
DATABASE_URL=postgresql+asyncpg://me_agent:me_agent@localhost:5432/me_agent
LLM_BASE_URL=https://api.gapgpt.app/v1
LLM_API_KEY=
LLM_MODEL_UNDERSTAND=gpt-4.1-mini
LLM_MODEL_GENERATE=gpt-4.1
LLM_MODEL_EMBED=text-embedding-3-small
LLM_MODEL_STT=whisper-1
LLM_MODEL_TTS=gpt-4o-mini-tts
LLM_MODEL_JUDGE=gemini-2.5-flash
EMBED_DIM=1536
DATA_DIR=../data
# Optional: raises GitHub's limit from 60 to 5000 requests/hour.
# GITHUB_TOKEN=
# Optional: hrcando's public career-page key is built in; set this only if they rotate it.
# HRCANDO_CAREER_AUTH_KEY=
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT=30/minute
# Reverse proxy address(es) trusted for X-Forwarded-For (rate limiting by client IP).
FORWARDED_ALLOW_IPS=127.0.0.1
# Behind Cloudflare only: rate-limit per visitor using the header it sets.
# RATE_LIMIT_CLIENT_HEADER=cf-connecting-ip

# Frontend (baked into the web image at build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
