# Backend
DATABASE_URL=postgresql+asyncpg://me_agent:me_agent@localhost:5432/me_agent
LLM_BASE_URL=https://api.gapgpt.app/v1
LLM_API_KEY=
LLM_MODEL_UNDERSTAND=gpt-4.1-mini
LLM_MODEL_GENERATE=gpt-4.1
LLM_MODEL_EMBED=text-embedding-3-small
LLM_MODEL_STT=whisper-1
LLM_MODEL_TTS=gpt-4o-mini-tts
LLM_MODEL_JUDGE=gemini-2.5-flash
EMBED_DIM=1536
DATA_DIR=../data
GITHUB_TOKEN=
HRCANDO_CAREER_AUTH_KEY=
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT=30/minute

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Reverse proxy address(es) trusted for X-Forwarded-For (rate limiting by client IP)
FORWARDED_ALLOW_IPS=127.0.0.1
